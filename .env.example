# =============================================================================
# CodeGuard 环境变量配置示例
# 复制此文件为 .env 并填入真实值（不要将 .env 提交到 Git）
# =============================================================================

# OpenAI API 密钥（必填）
# 用于 RealLLM 调用 OpenAI 兼容接口
# 获取方式：https://platform.openai.com/api-keys
OPENAI_API_KEY=your_key_here

# OpenAI API 基础 URL（可选）
# 默认使用 OpenAI 官方地址，可替换为代理或兼容服务（如 Azure、本地模型）
# 示例：https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM 模型名称（可选）
# 默认使用 gpt-4o-mini，可根据需要替换为其他模型
# 示例：gpt-4o-mini / gpt-4o / gpt-3.5-turbo
LLM_MODEL=gpt-4o-mini

# 日志级别（可选）
# 可选值：debug / info / warning / error
# 默认：info
LOG_LEVEL=info